# PHP-koden nås bara via front controllern. Övriga filer (lib/, api/, config.php)
# ska inte gå att hämta över HTTP.
#
# OBS: index.php MÅSTE vara tillåten — webrootens .htaccess skriver internt om
# /api hit, och en generell "Require all denied" här slår ut hela API:t.

<FilesMatch ".*">
    Require all denied
</FilesMatch>

<Files "index.php">
    Require all granted
</Files>
