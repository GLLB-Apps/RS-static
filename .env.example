# Kopiera till .env och fyll i. .env committas ALDRIG (se .gitignore).

# production eller development. I production visas inga stack traces.
APP_ENV=production

# Sökvägar till känsliga kataloger. Peka dem UTANFÖR webroot när webbhotellet
# tillåter det, t.ex. /home/anvandare/rogleskogen-data.
# Lämnas de tomma används projektets egna mappar (skyddade via .htaccess).
DATA_DIR=
UPLOADS_DIR=
DB_PATH=

# Namninsamlingens publika sida (används av signaturhämtningen).
# Kan även anges i data/settings.json under petition.url.
PETITION_URL=https://www.skrivunder.com/EXAKT_SLUG_HAR

# E-post (kontaktformulär + "skicka nytt lösenord" i Användare) skickas via
# PHP:s inbyggda mail() som standard — fungerar direkt på ett vanligt
# webbhotell (t.ex. Inleed), ingen nyckel behövs. Sätt en riktig avsändare på
# er egen domän; standarden (webbhotellets domännamn) fungerar men är sällan
# den man vill ha permanent.
MAIL_FROM_ADDRESS=no-reply@raddarogleskogen.se
MAIL_FROM_NAME=Rädda Rögleskogen

# Valfritt: skickar via Resend i stället för mail() om satt (t.ex. om ni redan
# har ett Resend-konto, eller vill ha leveransstatistik). Annars ignoreras.
RESEND_API_KEY=

# Valfritt: AI-översättning av commit-rubriker i ändringsloggens GitHub-import
# (server/api/changelog.php). Tomt = rubrikerna importeras oöversatta.
ANTHROPIC_API_KEY=

# Kommaseparerade origins som får anropa API:t från en annan domän.
# Lämna tomt när React-build och PHP ligger på samma domän (normalfallet).
CORS_ORIGINS=
